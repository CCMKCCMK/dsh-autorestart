{
  "name": "dsh-autorestart",
  "version": "0.9.0",
  "type": "module",
  "description": "DeepSeek Harness plugin: idle-aware restart with session resume, a snapshot of the configuration and plugins before every restart, a clear-out of the stale login cookies behind \"Web authentication failed\", and a countdown shutdown; verified on the Windows desktop client and on hosted dsh web on WSL with systemd; implemented but not yet verified on hosted dsh web on Windows, on WSL without systemd, and on native Linux. AI-generated, not human-reviewed: use with caution.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "continuation",
    "session-resume",
    "graceful-restart"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eason-22/dsh-autorestart.git"
  },
  "homepage": "https://github.com/Eason-22/dsh-autorestart#readme",
  "bugs": {
    "url": "https://github.com/Eason-22/dsh-autorestart/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "supervisor/supervisor.js",
    "scripts/clear-dsh-auth-cookies.mjs",
    "scripts/run-tests.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "assets/*.ico",
    "screenshots.json",
    "README.md",
    "CHANGELOG.md",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
